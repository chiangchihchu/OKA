<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>東京馬拉松終點指南 2026</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- Leaflet CSS and JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body { font-family: 'Noto Sans TC', sans-serif; background-color: #f3f4f6; }
        .timeline-line { position: absolute; left: 15px; top: 30px; bottom: 0; width: 2px; background: #e5e7eb; z-index: 0; }
        .timeline-item { position: relative; z-index: 10; padding-bottom: 2rem; padding-left: 2.5rem; }
        .timeline-dot { position: absolute; left: 6px; top: 6px; width: 20px; height: 20px; border-radius: 50%; background: #fff; border: 4px solid; }
        #map-container { height: 400px; width: 100%; border-radius: 0.75rem; z-index: 0; }
        /* Custom map marker styles could go here if needed */
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useMemo, useEffect, useRef } = React;

        // 資料結構：包含經緯度 (Lat, Lng)
        const routes = [
            // 向左轉 (Turn LEFT)
            {
                id: 'navy',
                colorName: '深藍色 (Navy)',
                colorCode: '#000080',
                direction: '完賽後向左轉',
                destination: '明治安田 Village (Meiji Yasuda Village)',
                lat: 35.6796, lng: 139.7633,
                hasBaggage: true,
                changingArea: '明治安田大廳 (Meiji Yasuda Hall)',
                exit: '直通地下連通道前往東京站'
            },
            {
                id: 'blue',
                colorName: '藍色 (Blue)',
                colorCode: '#0000FF',
                direction: '完賽後向左轉',
                destination: '馬場先門 (Babasaki Gate) / 鍛冶橋通',
                lat: 35.6782, lng: 139.7620,
                hasBaggage: true,
                changingArea: '馬場先門 (鍛冶橋通)',
                exit: '穿越馬場先門路口，走B7出口前往有樂町站'
            },
            {
                id: 'lightblue',
                colorName: '淺藍色 (Light Blue)',
                colorCode: '#87CEEB',
                direction: '完賽後向左轉',
                destination: '馬場先門 (Babasaki Gate) / 鍛冶橋通',
                lat: 35.6782, lng: 139.7620,
                hasBaggage: true,
                changingArea: '馬場先門 (鍛冶橋通)',
                exit: '穿越馬場先門路口，走B7出口前往有樂町站'
            },
            {
                id: 'purple',
                colorName: '紫色 (Purple)',
                colorCode: '#800080',
                direction: '完賽後向左轉',
                destination: '馬場先門 (Babasaki Gate) / 鍛冶橋通',
                lat: 35.6782, lng: 139.7620,
                hasBaggage: true,
                changingArea: '馬場先門 (鍛冶橋通)',
                exit: '前往海外旅遊套裝行程參加者巴士 / 南高停車場'
            },
            // 左前方 (Top Left)
            {
                id: 'white',
                colorName: '白色 (White)',
                colorCode: '#FFFFFF',
                borderColor: '#ccc',
                direction: '完賽後前往左前方',
                destination: '皇居外苑馬場先地區',
                lat: 35.6800, lng: 139.7570,
                hasBaggage: false,
                changingArea: '皇居外苑 (Kokyo Gaien)',
                exit: '從2號出口前往東京站 / 有樂町站'
            },
            {
                id: 'gold',
                colorName: '金色 (Gold)',
                colorCode: '#FFD700',
                direction: '完賽後前往左前方',
                destination: '皇居外苑馬場先地區',
                lat: 35.6800, lng: 139.7570,
                hasBaggage: false,
                changingArea: '皇居外苑 (Kokyo Gaien)',
                exit: '從2號出口前往東京站 / 有樂町站'
            },
            // 向右轉 (Turn RIGHT)
            {
                id: 'green',
                colorName: '綠色 (Green)',
                colorCode: '#008000',
                direction: '完賽後向右轉',
                destination: '三井住友銀行東館 (SMBC East Tower)',
                lat: 35.6843, lng: 139.7643,
                hasBaggage: true,
                changingArea: '三井住友銀行東館',
                exit: '從大手町站經地下直通東京站 (地面路線)'
            },
            {
                id: 'brown',
                colorName: '棕色 (Brown)',
                colorCode: '#A52A2A',
                direction: '完賽後向右轉',
                destination: '東京產經大廈 (Tokyo Sankei Bldg)',
                lat: 35.6853, lng: 139.7653,
                hasBaggage: true,
                changingArea: '東京產經大廈 Hall & Conference',
                exit: '從大手町站經地下直通東京站 (地面路線)'
            },
            {
                id: 'lightgreen',
                colorName: '淺綠色 (Light Green)',
                colorCode: '#90EE90',
                direction: '完賽後向右轉',
                destination: '大手町 Financial City',
                lat: 35.6865, lng: 139.7645,
                hasBaggage: true,
                changingArea: '大手町 Financial City 會議中心',
                exit: '從大手町站經地下直通東京站 (地面路線)'
            },
            {
                id: 'orange',
                colorName: '橘色 (Orange)',
                colorCode: '#FFA500',
                direction: '完賽後向右轉',
                destination: '大手町 PLACE',
                lat: 35.6860, lng: 139.7675,
                hasBaggage: true,
                changingArea: '大手町 PLACE 會議中心',
                exit: '從大手町站經地下直通東京站 (地面路線)'
            },
            {
                id: 'black',
                colorName: '黑色 (Black)',
                colorCode: '#000000',
                direction: '完賽後向右轉',
                destination: '東京站',
                lat: 35.6812, lng: 139.7660,
                hasBaggage: false,
                changingArea: '東京站行幸通 (Gyoko-Dori)',
                exit: '前往東京站'
            },
            {
                id: 'gray',
                colorName: '灰色 (Gray)',
                colorCode: '#808080',
                direction: '完賽後向右轉',
                destination: 'TOKIA Galleria (東京大樓)',
                lat: 35.6785, lng: 139.7640,
                hasBaggage: false,
                changingArea: 'TOKIA Galleria',
                exit: '前往東京站 / 有樂町站'
            },
            {
                id: 'pink',
                colorName: '粉紅色 (Pink)',
                colorCode: '#FFC0CB',
                direction: '完賽後向右轉',
                destination: '東京國際論壇 (Tokyo Int. Forum)',
                lat: 35.6769, lng: 139.7637,
                hasBaggage: false,
                changingArea: '東京國際論壇 B5',
                exit: '前往東京站 / 有樂町站'
            }
        ];

        // Map Component
        function MapComponent({ selectedColor, filteredRoutes }) {
            const mapRef = useRef(null);
            const mapInstanceRef = useRef(null);
            const markersRef = useRef([]);

            useEffect(() => {
                // Initialize map if not already initialized
                if (!mapInstanceRef.current && document.getElementById('map')) {
                    const map = L.map('map').setView([35.6812, 139.7671], 15); // Center on Tokyo Station
                    
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                    }).addTo(map);

                    mapInstanceRef.current = map;
                }
            }, []);

            useEffect(() => {
                const map = mapInstanceRef.current;
                if (!map) return;

                // Clear existing markers
                markersRef.current.forEach(marker => marker.remove());
                markersRef.current = [];

                // Add markers for filtered routes
                const group = L.featureGroup();
                
                // Add a permanent marker for Finish Line
                const finishIcon = L.divIcon({
                    className: 'custom-div-icon',
                    html: `<div style="background-color: #ef4444; width: 15px; height: 15px; border-radius: 50%; border: 2px solid white; box-shadow: 0 0 5px rgba(0,0,0,0.5);"></div>`,
                    iconSize: [15, 15],
                    iconAnchor: [7, 7]
                });
                const finishMarker = L.marker([35.6812, 139.7625], { icon: finishIcon }).addTo(map)
                    .bindPopup("<b>馬拉松終點線 (Finish Line)</b><br>行幸通 (Gyoko-dori)");
                group.addLayer(finishMarker);

                filteredRoutes.forEach(route => {
                    const color = route.colorCode === '#FFFFFF' ? '#999' : route.colorCode; // Make white visible
                    
                    const markerHtml = `
                        <div style="
                            background-color: ${color};
                            width: 24px;
                            height: 24px;
                            border-radius: 50%;
                            border: 3px solid white;
                            box-shadow: 0 2px 5px rgba(0,0,0,0.4);
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            color: white;
                            font-size: 10px;
                            font-weight: bold;
                        ">
                            <i class="fas fa-flag"></i>
                        </div>
                    `;

                    const icon = L.divIcon({
                        className: 'custom-marker',
                        html: markerHtml,
                        iconSize: [24, 24],
                        iconAnchor: [12, 12]
                    });

                    const marker = L.marker([route.lat, route.lng], { icon: icon })
                        .addTo(map)
                        .bindPopup(`
                            <div style="text-align: center;">
                                <strong style="color: ${color}">${route.colorName}</strong><br>
                                ${route.destination}
                            </div>
                        `);
                    
                    markersRef.current.push(marker);
                    group.addLayer(marker);
                });

                // Fit bounds if we have filtered routes, otherwise reset view
                if (filteredRoutes.length === 1) {
                    map.setView([filteredRoutes[0].lat, filteredRoutes[0].lng], 16);
                    markersRef.current[0].openPopup();
                } else if (filteredRoutes.length > 0) {
                    map.fitBounds(group.getBounds(), { padding: [50, 50] });
                } else {
                    map.setView([35.6812, 139.7671], 15);
                }

            }, [filteredRoutes]);

            return <div id="map" className="w-full h-full rounded-xl shadow-inner"></div>;
        }

        function App() {
            const [selectedColor, setSelectedColor] = useState(null);

            const filteredRoutes = useMemo(() => {
                if (!selectedColor) return routes;
                return routes.filter(r => r.id === selectedColor);
            }, [selectedColor]);

            return (
                <div className="min-h-screen pb-12">
                    {/* Header Title */}
                    <div className="bg-orange-600 text-white shadow-lg">
                        <div className="container mx-auto px-4 py-4">
                            <h1 className="text-xl md:text-2xl font-bold">
                                Marathon Finish Area : In front of Tokyo Station, Gyoko-dori Ave. / Otemachi / Hibiya-dori Ave
                            </h1>
                        </div>
                    </div>

                    {/* Detailed Info Section (Restored from Original Image) */}
                    <div className="bg-white border-b border-gray-200">
                        <div className="container mx-auto px-4 py-6">
                            <div className="flex flex-col md:flex-row gap-6">
                                {/* Left Side: Times */}
                                <div className="md:w-1/3 flex flex-col justify-center space-y-4">
                                    <div className="flex items-center text-orange-600 font-bold text-lg md:text-xl">
                                        <span className="w-24 text-right mr-3">11 : 15 a.m.</span>
                                        <span className="text-gray-800">輪椅賽結束 (End of Wheelchair Race)</span>
                                    </div>
                                    <div className="flex items-center text-orange-600 font-bold text-lg md:text-xl">
                                        <span className="w-24 text-right mr-3">4 : 10 p.m.</span>
                                        <span className="text-gray-800">馬拉松結束 (End of Marathon)</span>
                                    </div>
                                    <div className="mt-2 text-sm text-red-600 font-bold bg-red-50 p-2 rounded border border-red-100">
                                        * 完賽後的動線將嚴格根據您的「號碼布顏色 (Bib Color)」進行分流。
                                    </div>
                                </div>

                                {/* Right Side: Descriptions */}
                                <div className="md:w-2/3 text-sm md:text-base text-gray-700 space-y-3 leading-relaxed border-l-0 md:border-l-2 md:pl-6 border-gray-100">
                                    <p>
                                        <i className="fas fa-gift text-orange-500 mr-2"></i>
                                        <strong>跑者服務：</strong> 預計包含完賽獎牌、水、運動飲料、完賽毛巾/長袍等。
                                    </p>
                                    <p>
                                        <i className="fas fa-restroom text-orange-500 mr-2"></i>
                                        我們設有<strong>「通用更衣室 (Universal changing room)」</strong>。如果您希望使用此設施，請洽詢工作人員引導。
                                    </p>
                                    <p>
                                        <i className="fas fa-users text-orange-500 mr-2"></i>
                                        我們設置了<strong>「會合區 (Meet-up area)」</strong>供跑者與親友會合。
                                        <br/>
                                        <span className="text-gray-500 text-xs ml-6 block mt-1">
                                            * 跑者通過終點線後，大約需要 30 分鐘才能抵達更衣區。請親友直接前往會合區等候並迎接完賽跑者！
                                        </span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div className="container mx-auto px-4 py-6">
                        
                        {/* Map Section */}
                        <div className="bg-white rounded-xl shadow-md p-1 mb-8">
                            <div className="p-3 border-b border-gray-100 flex justify-between items-center">
                                <h2 className="font-bold text-gray-800">
                                    <i className="fas fa-map-marked-alt mr-2 text-blue-600"></i>
                                    現場地圖 (Venue Map)
                                </h2>
                                <span className="text-xs text-gray-400">
                                    * 根據 Google 搜尋資料查證繪製
                                </span>
                            </div>
                            <div id="map-container">
                                <MapComponent selectedColor={selectedColor} filteredRoutes={filteredRoutes} />
                            </div>
                        </div>

                        {/* Color Filter */}
                        <div className="bg-white rounded-xl shadow-md p-6 mb-8">
                            <h2 className="text-lg font-bold text-gray-800 mb-4 text-center">
                                👇 請點擊您的號碼布顏色以查看詳細動線 👇
                            </h2>
                            <div className="flex flex-wrap justify-center gap-3">
                                <button 
                                    onClick={() => setSelectedColor(null)}
                                    className={`px-4 py-2 rounded-full text-sm font-medium transition-all ${selectedColor === null ? 'bg-gray-800 text-white shadow-lg scale-105' : 'bg-gray-200 text-gray-600 hover:bg-gray-300'}`}
                                >
                                    顯示全部
                                </button>
                                {routes.map(route => (
                                    <button
                                        key={route.id}
                                        onClick={() => setSelectedColor(route.id)}
                                        className={`flex items-center px-4 py-2 rounded-full border transition-all shadow-sm hover:shadow-md ${selectedColor === route.id ? 'ring-2 ring-offset-2 ring-blue-500 scale-105' : 'hover:scale-105'}`}
                                        style={{
                                            backgroundColor: selectedColor === route.id ? '#f0f9ff' : 'white',
                                            borderColor: route.colorCode === '#FFFFFF' ? '#ccc' : route.colorCode
                                        }}
                                    >
                                        <span 
                                            className="w-4 h-4 rounded-full mr-2 border border-gray-200"
                                            style={{ backgroundColor: route.colorCode }}
                                        ></span>
                                        <span className="text-gray-700 font-medium text-sm">{route.colorName.split(' ')[0]}</span>
                                    </button>
                                ))}
                            </div>
                        </div>

                        {/* Result Cards */}
                        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            {filteredRoutes.map((route) => (
                                <div key={route.id} className="bg-white rounded-xl shadow-lg overflow-hidden border-t-8 transition-all hover:shadow-xl" style={{ borderColor: route.colorCode }}>
                                    {/* Card Header */}
                                    <div className="bg-gray-50 p-4 border-b border-gray-100">
                                        <div className="flex justify-between items-center">
                                            <div className="flex items-center">
                                                <div 
                                                    className="w-8 h-8 rounded shadow-sm mr-3 border border-gray-200"
                                                    style={{ backgroundColor: route.colorCode }}
                                                ></div>
                                                <h3 className="font-bold text-lg text-gray-800">{route.colorName}</h3>
                                            </div>
                                            <span className={`text-xs px-2 py-1 rounded font-bold ${route.direction.includes('左') ? 'bg-red-100 text-red-700' : 'bg-blue-100 text-blue-700'}`}>
                                                {route.direction}
                                            </span>
                                        </div>
                                        <div className="mt-2 text-sm text-gray-600 font-medium">
                                            <i className="fas fa-map-marker-alt text-red-500 mr-1"></i>
                                            目的地：{route.destination}
                                        </div>
                                    </div>

                                    {/* Timeline Body */}
                                    <div className="p-4 relative">
                                        <div className="timeline-line"></div>

                                        {/* Step 1: Finish */}
                                        <div className="timeline-item">
                                            <div className="timeline-dot" style={{ borderColor: '#ef4444' }}></div>
                                            <p className="font-bold text-gray-800 text-sm">終點 (Finish)</p>
                                        </div>

                                        {/* Step 2: Services */}
                                        <div className="timeline-item">
                                            <div className="timeline-dot" style={{ borderColor: '#f59e0b' }}></div>
                                            <p className="font-bold text-gray-800 text-sm">跑者服務</p>
                                            <p className="text-xs text-gray-500">獎牌、毛巾、飲料</p>
                                        </div>

                                        {/* Step 3: Baggage */}
                                        <div className="timeline-item">
                                            <div className="timeline-dot" style={{ borderColor: route.hasBaggage ? '#3b82f6' : '#9ca3af', backgroundColor: route.hasBaggage ? '#fff' : '#e5e7eb' }}></div>
                                            <p className={`font-bold text-sm ${route.hasBaggage ? 'text-gray-800' : 'text-gray-400 line-through'}`}>
                                                行李領取
                                            </p>
                                            {!route.hasBaggage && (
                                                <span className="inline-block bg-gray-200 text-gray-600 text-xs px-2 py-0.5 rounded mt-1">
                                                    無行李寄放
                                                </span>
                                            )}
                                        </div>

                                        {/* Step 4: Changing */}
                                        <div className="timeline-item">
                                            <div className="timeline-dot" style={{ borderColor: '#10b981' }}></div>
                                            <p className="font-bold text-gray-800 text-sm">更衣區</p>
                                            <div className="bg-green-50 p-2 rounded mt-1 border border-green-100">
                                                <p className="text-sm font-semibold text-green-800">{route.changingArea}</p>
                                            </div>
                                        </div>

                                        {/* Step 5: Exit */}
                                        <div className="timeline-item !pb-0">
                                            <div className="timeline-dot" style={{ borderColor: '#6366f1' }}></div>
                                            <p className="font-bold text-gray-800 text-sm">離場 / 交通</p>
                                            <p className="text-sm text-gray-600 mt-1">{route.exit}</p>
                                        </div>
                                    </div>
                                </div>
                            ))}
                        </div>
                        
                        {filteredRoutes.length === 0 && (
                             <div className="text-center py-12">
                                <p className="text-gray-500">未找到相關路線資訊</p>
                             </div>
                        )}
                    </div>

                    {/* Footer */}
                    <footer className="bg-gray-800 text-gray-300 py-8 mt-12">
                        <div className="container mx-auto px-4 text-center">
                            <p className="mb-2">東京馬拉松 2026 終點指南非官方輔助網頁</p>
                            <p className="text-xs opacity-60">資料來源：Tokyo Marathon Foundation 官方指引</p>
                            <p className="text-xs opacity-60 mt-4">
                                *譯名已根據常見中文地圖進行校正，實際請以現場日文/英文標示為主。
                            </p>
                            <p className="text-xs opacity-40 mt-2">
                                Map data &copy; <a href="https://www.openstreetmap.org/copyright" className="underline">OpenStreetMap</a> contributors
                            </p>
                        </div>
                    </footer>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
